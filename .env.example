# Google Cloud project and BigQuery datasets
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./servicekey.json
BIGQUERY_LOCATION=US
BIGQUERY_RAW_DATASET=food_waste_raw
BIGQUERY_STAGING_DATASET=food_waste_staging
BIGQUERY_ANALYTICS_DATASET=food_waste_analytics
BIGQUERY_RAW_TABLE=food_waste_records

# Airbyte API (use the base URL reachable from Airflow)
AIRBYTE_API_URL=http://host.docker.internal:8000/api/public/v1
AIRBYTE_API_TOKEN=
AIRBYTE_API_CLIENT_ID=
AIRBYTE_API_CLIENT_SECRET=
AIRBYTE_CONNECTION_ID=your-airbyte-connection-id

# dbt profile (reuse the workspace servicekey.json)
DBT_BIGQUERY_METHOD=service-account
DBT_BIGQUERY_KEYFILE=./servicekey.json

# Standalone HTML dashboard API server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

